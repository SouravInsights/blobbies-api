# The Blobbies HTTP API — environment
#
# Copy to `.env` and edit. Every value has a working default, so an empty file
# is a valid configuration.

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# 1 turns on Fastify's request log (pino JSON to stdout). Off by default so a
# local run stays quiet; a platform like Lightsail usually wants it on.
LOGGER=0

# Prefer MORE than one worker on a multi-core box. Each worker is its own Node
# process listening on the same port (node:cluster).
WORKERS=1

# --- CORS -------------------------------------------------------------------
# Comma-separated origins, or `*` for any. The API is read-only and public, so
# `*` is the default.
CORS_ORIGIN=*

# --- Rate limit -------------------------------------------------------------
# Max requests per window per IP. Set RATE_LIMIT_MAX=0 to disable.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute

# --- Caching ----------------------------------------------------------------
# Output is deterministic (same URL → same bytes, forever), so this can be
# enormous. A year by default; every response also carries an ETag.
CACHE_CONTROL_MAX_AGE=31536000

# --- Formats ----------------------------------------------------------------
# SVG and JSON need no native dependencies and are always on. Raster formats
# are added separately (see the README).
